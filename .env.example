# ─────────────────────────────────────────────────────────────
# StockLume — environment variables overview
# Each app has its own .env.example with the exact variables it reads:
#   apps/api/.env.example  → copy to apps/api/.env
#   apps/web/.env.example  → copy to apps/web/.env.local
# Never commit real values. .env files are git-ignored.
# ─────────────────────────────────────────────────────────────

# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# PostgreSQL connection string (Dashboard → Connect → Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
# Supabase root CA (Project Settings → Database → SSL Configuration). Required for the API in production.
DATABASE_CA_CERT=

# Where the API is reachable from the browser
NEXT_PUBLIC_API_URL=http://localhost:4000/api
