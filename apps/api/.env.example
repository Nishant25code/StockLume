# Copy to apps/api/.env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (Supabase → Connect → Transaction pooler, port 6543 — works well on Vercel)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Auth (Supabase → Project Settings → API). Used to verify user access tokens.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
