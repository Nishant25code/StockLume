# Copy to apps/api/.env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (Supabase → Connect → Transaction pooler, port 6543 — works well on Vercel)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase root CA certificate (PEM) so the API can VERIFY the database's TLS certificate.
# Supabase → Project Settings → Database → SSL Configuration → Download certificate.
# Paste the file contents; on one line, write newlines as \n. REQUIRED in production.
DATABASE_CA_CERT=

# Only if you really cannot set DATABASE_CA_CERT: allow an encrypted but UNVERIFIED connection
# in production (vulnerable to man-in-the-middle). Leave unset.
# DATABASE_SSL_ALLOW_UNVERIFIED=true

# Supabase Auth (Supabase → Project Settings → API). Used to verify user access tokens.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
