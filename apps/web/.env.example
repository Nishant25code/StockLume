# Copy to apps/web/.env.local and fill in real values. Never commit .env.local.
# NEXT_PUBLIC_* values are visible in the browser — only put public values here.

# Express API base URL (include /api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Supabase (Project Settings → API). The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
